{
  "name": "rulefall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "See which instructions reach your coding agent, when, and why.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LyraZeta/rulefall.git"
  },
  "homepage": "https://lyrazeta.github.io/rulefall/",
  "bugs": {
    "url": "https://github.com/LyraZeta/rulefall/issues"
  },
  "keywords": [
    "coding-agents",
    "agents-md",
    "claude-code",
    "openai-codex",
    "cursor",
    "github-copilot",
    "local-first"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "lucide-react": "^1.44.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.19.0"
}
